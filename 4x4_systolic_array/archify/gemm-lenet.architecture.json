  "cards": [
    {
      "dot": "cyan",
      "title": "指令流水线",
      "items": [
        "Fetcher 按 PC 从程序存储器异步取指",
        "Decoder 将 16 位指令译为控制信号",
        "Scheduler 用 FETCH→DECODE→REQUEST→WAIT→EXECUTE→UPDATE 状态机驱动线程"
      ]
    },
    {
      "dot": "emerald",
      "title": "GEMM 脉动路径",
      "items": [
        "Adapter 从数据存储器读入输入矩阵",
        "以阶梯 (skew) 时序从 north/west 喂入 4×4 PE 网格",
        "结果经 result_flat 回写数据存储器"
      ]
    },
    {
      "dot": "rose",
      "title": "SIMD 线程",
      "items": [
        "每个线程一条通道：ALU/LSU/寄存器堆/PC",
        "同一指令多数据 (SIMD) 并行",
        "LSU 访存异步，Scheduler 等待其完成"
      ]
    }
  ]
